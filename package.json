{
  "name": "nyc-walks-map",
  "version": "1.0.0",
  "type": "module",
  "description": "NYC 20-Mile Walks Tracker, Route Planner, Local Tile Cacher & Static Map Exporter",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "app": "vite build && electron .",
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "dev:web": "concurrently -k \"tsx server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "export:static": "vite build --outDir dist-static && node scripts/finalize-static.mjs",
    "migrate": "python scripts/migrate_kmz.py"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.0.9",
    "jspdf": "^3.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.487.0",
    "maplibre-gl": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.5"
  }
}
