{
  "name": "nyc-walks-map",
  "productName": "NYC Walks Map",
  "version": "1.0.0",
  "type": "module",
  "description": "NYC 20-Mile Walks Tracker, Route Planner, Local Tile Cacher & Static Map Exporter",
  "author": "geem4",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "app": "vite build && electron .",
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "dev:web": "concurrently -k \"tsx server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "export:static": "vite build --outDir dist-static && node scripts/finalize-static.mjs",
    "pack:win": "vite build && electron-builder --win nsis dir",
    "migrate": "python scripts/migrate_kmz.py"
  },
  "build": {
    "appId": "com.geem4.nycwalksmap",
    "productName": "NYC Walks Map",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/data/*.json",
      "public/data/*.geojson",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NYC Walks Map"
    }
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.0.9",
    "jspdf": "^3.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.487.0",
    "maplibre-gl": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.1.3",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.5"
  }
}
